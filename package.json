{
  "name": "mavy",
  "version": "0.1.0",
  "private": true,
  "description": "Mávy: private MÁV / GYSEV train tracker PWA",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "postinstall": "bun install --cwd web",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd web build",
    "start": "bun src/server.ts",
    "typecheck": "tsc -p tsconfig.json && bun run --cwd web typecheck",
    "import-gtfs": "bun src/gtfs/import.ts",
    "icons": "bun scripts/make-icons.ts",
    "test": "bun test"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
